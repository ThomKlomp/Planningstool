// Prisma schema voor de horeca-planningstool
// Multi-tenant model: elk "Company" record is een aparte zaak/omgeving.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Platform-level (jouw admin-portaal) ----------

// PlatformAdmin staat los van een Company: dit ben jij, de beheerder van de hele SaaS.
model PlatformAdmin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ---------- Tenant / Company ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // gebruikt in URL, bv. cafedepub.jouwtool.nl of /c/cafedepub
  timezone  String   @default("Europe/Amsterdam")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invites     Invite[]
  shifts      Shift[]
  timeEntries TimeEntry[]
  weeks       WeekStatus[]
  shiftTemplates ShiftTemplate[]
  closedDays  ClosedDay[]
  rosterWeeks RosterWeek[]
  rosterEvents RosterEvent[]
  autoOpenWeeks Int @default(2) // hoeveel weken vooruit de datumprikker standaard open staat
  showCompanyRosterToEmployees Boolean @default(true) // medewerkers mogen het hele bedrijfsrooster zien, niet alleen hun team/eigen dienst
  autoApproveShiftSwaps Boolean @default(false) // medewerkers mogen overnemen/ruilen zonder managergoedkeuring
  autoApproveHours Boolean @default(false) // ingediende uren worden automatisch goedgekeurd zonder managergoedkeuring

  // ---------- Abonnement ----------
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  billingInterval    BillingInterval?
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  mollieCustomerId     String?
  mollieSubscriptionId String?
  currentTierId        String?  // laatst doorgevoerde staffel-id ("S" | "M" | "L" | "XL"), voor drift-detectie
  lastBilledAmountIncl Float?   // laatst naar Mollie doorgevoerde bedrag incl. btw
  periodTierId         String?  // hoogste staffel waarvoor in de lopende betaalperiode (jaar) al betaald is; basis voor bijbetaling bij groei
  tierUpgradeCharges   TierUpgradeCharge[]
  shiftSwapRequests ShiftSwapRequest[]
  notifications Notification[]
  closedWeekdays Int[] @default([]) // vaste sluitingsdagen, bv. [1,2] = elke ma+di dicht (0=zo...6=za)
  departments Department[]

  // ---------- Bedrijfsgegevens (voor facturering) ----------
  billingName String? // officiële bedrijfsnaam, kan afwijken van "name" hierboven
  kvkNumber   String?
  vatNumber   String? // btw-nummer, optioneel (niet elke eenmanszaak heeft er een)
  address     String?
  postalCode  String?

  discount CompanyDiscount?
}

// Teams/afdelingen binnen een zaak, bv. "Bediening", "Keuken". Een lid
// hoort bij maximaal één team, gebruikt om het rooster overzichtelijker
// te maken.
model Department {
  id        String   @id @default(cuid())
  companyId String
  name      String
  color     String   @default("#3F6E5B")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([companyId])
}

// Dagen dat de zaak dicht is (vakantie, feestdag), geen beschikbaarheid
// nodig, geen shifts, en uren kunnen er niet op ingediend worden.
model ClosedDay {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
}

// Standaard shifts die de eigenaar/manager instelt (bv. "Middagshift
// 12:00-18:00 op ma-vr"). Worden gebruikt als per-shift opties op de
// beschikbaarheidspagina, in plaats van alleen "hele dag".
model ShiftTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  startTime String
  endTime   String
  weekdays  Int[] // 0 = zondag ... 6 = zaterdag (JavaScript Date.getDay())
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum Role {
  OWNER // eigenaar van de zaak, volledige rechten binnen de company
  MANAGER // maakt roosters, keurt uren goed
  EMPLOYEE // vult beschikbaarheid en uren in
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE // laatste betaling mislukt
  CANCELED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// Koppeltabel user <-> company, met rol. Eén user kan (in theorie) bij meerdere zaken werken.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(EMPLOYEE)
  departmentId String?
  createdAt DateTime @default(now())
  calendarToken String? @unique // geheime token voor de ICS-agenda-feed van deze medewerker

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  availabilities Availability[]
  shifts         Shift[]
  timeEntries    TimeEntry[]

  @@unique([userId, companyId])
}

// Uitnodiging van een medewerker per e-mail, voordat die een account heeft.
model Invite {
  id        String   @id @default(cuid())
  email     String
  role      Role     @default(EMPLOYEE)
  token     String   @unique @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?

  @@index([companyId])
}

// ---------- User ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // alleen gezet voor accounts die met e-mail+wachtwoord zijn aangemaakt

  accounts Account[]
  sessions Session[]

  memberships   Membership[]
  platformAdmin PlatformAdmin?
  supportConversations SupportConversation[]

  createdAt DateTime @default(now())
}

// ---------- Beschikbaarheid ("datumprikker") ----------

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  UNSURE // weet ik nog niet
}

model Availability {
  id           String             @id @default(cuid())
  membershipId String
  date         DateTime           @db.Date
  // dagdeel; laat leeg ("") voor hele dag, of gebruik bv. "ochtend" / "middag" / "avond".
  // Bewust geen nullable veld: NULL gedraagt zich onvoorspelbaar in een composite
  // unique constraint (elke NULL telt als uniek), leeg-string voorkomt dat.
  daypart      String  @default("")
  status       AvailabilityStatus @default(AVAILABLE)
  note         String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([membershipId, date, daypart])
  @@index([date])
}

// Per company, per week: staat de beschikbaarheid-invoer open of heeft de
// manager/eigenaar 'm gesloten (bv. omdat het rooster al vaststaat).
// Geen record voor een week = standaard open.
model WeekStatus {
  id        String   @id @default(cuid())
  companyId String
  weekStart DateTime @db.Date // maandag van de betreffende week
  isOpen    Boolean  @default(true)
  notifiedAt DateTime? // wanneer de "week is open"-mail voor deze week verstuurd is

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([companyId, weekStart])
}

// Publicatiestatus van het rooster per week. Zolang een (huidige of
// toekomstige) week niet gepubliceerd is, zien alleen eigenaar/managers het
// rooster; medewerkers zien dan een melding dat het nog niet klaar is.
// Geen record = niet gepubliceerd. Weken in het verleden zijn altijd zichtbaar.
model RosterWeek {
  id          String    @id @default(cuid())
  companyId   String
  weekStart   DateTime  @db.Date // maandag van de betreffende week
  published   Boolean   @default(false)
  publishedAt DateTime?
  notifiedAt  DateTime? // wanneer medewerkers voor het eerst een melding kregen
  emailedAt   DateTime? // wanneer het rooster voor het laatst per mail naar het team is gestuurd
  emailedCount Int?     // naar hoeveel teamleden

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, weekStart])
}

// Evenement op het rooster, bv. "Feestje van Bas" op zaterdag. Hoort bij een
// losse dag (date) of bij een hele week (weekStart), nooit beide.
model RosterEvent {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime? @db.Date
  weekStart   DateTime? @db.Date
  title       String
  description String?
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, weekStart])
}

// ---------- Rooster ----------

model Shift {
  id           String   @id @default(cuid())
  companyId    String
  membershipId String? // null = openstaande shift, nog niet toegewezen
  date         DateTime @db.Date
  startTime    String // "17:00"
  endTime      String // "23:00"
  role         String? // bv. "bediening", "keuken", "bar"
  note         String?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  timeEntry  TimeEntry?
  swapRequest ShiftSwapRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, date])
}

// ---------- Overnemen / ruilen van diensten ----------

enum ShiftSwapStatus {
  OPEN // aangeboden, wachtend op iemand die 'm overneemt
  PENDING_APPROVAL // iemand heeft 'm geclaimd, wacht op manager
  APPROVED
  REJECTED
  CANCELLED // ingetrokken door de aanbieder voordat iemand claimde
}

model ShiftSwapRequest {
  id            String          @id @default(cuid())
  companyId     String
  shiftId       String          @unique // één actief aanbod per shift
  offeredById   String // membershipId van wie de dienst aanbiedt
  claimedById   String? // membershipId van wie 'm overneemt
  claimedAt     DateTime?
  reviewedById  String? // membershipId van de manager die goed-/afkeurde
  reviewedAt    DateTime?
  status        ShiftSwapStatus @default(OPEN)
  claimedAsSwap Boolean         @default(false) // true = "Ruilen" gekozen bij overnemen, false = gewoon "Overnemen"
  notifiedMembershipIds String[] @default([]) // wie een melding kreeg toen dit werd aangeboden
  createdAt     DateTime        @default(now())

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift     Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  proposals ShiftSwapProposal[]

  @@index([companyId, status])
}

// Een ruilvoorstel: iemand wil een aangeboden dienst NIET overnemen maar er
// een eigen dienst voor terug geven. Dit loopt bewust niet via de manager:
// aanbieder en voorsteller spreken onderling af en de manager past daarna
// zelf het rooster aan. Het aanbod blijft OPEN totdat het wordt ingetrokken
// of iemand de dienst overneemt.
model ShiftSwapProposal {
  id            String   @id @default(cuid())
  swapRequestId String
  proposedById  String // membershipId van wie wil ruilen
  note          String?
  createdAt     DateTime @default(now())

  swapRequest ShiftSwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)

  @@unique([swapRequestId, proposedById])
  @@index([swapRequestId])
}

// ---------- Meldingen ----------

model Notification {
  id           String   @id @default(cuid())
  companyId    String
  membershipId String // voor wie deze melding is
  title        String
  body         String?
  link         String? // relatief pad binnen de app, bv. /dashboard/roster
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([membershipId, read])
}

// ---------- Support-chat (bolletje rechtsonder) ----------

model SupportConversation {
  id         String   @id @default(cuid())
  userId     String? // ingelogde gebruiker, indien van toepassing
  guestToken String?  @unique // willekeurige token voor niet-ingelogde bezoekers
  guestName  String?
  guestEmail String?
  status     String   @default("OPEN") // OPEN of CLOSED
  notifiedAt DateTime? // wanneer de "nieuwe chat"-mail voor het laatst verstuurd is
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages SupportMessage[]
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model SupportMessage {
  id             String   @id @default(cuid())
  conversationId String
  sender         String // "USER" of "SUPPORT"
  body           String
  createdAt      DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum TimeEntryStatus {
  DRAFT // vooraf ingevuld op basis van een ingeroosterde shift, medewerker moet nog bevestigen
  SUBMITTED
  APPROVED
  REJECTED
  QUERIED // manager heeft een vraag, medewerker moet aanpassen en opnieuw indienen
}

model TimeEntry {
  id           String          @id @default(cuid())
  companyId    String
  membershipId String
  shiftId      String?         @unique // gekoppelde shift, indien vooraf ingevuld vanuit het rooster
  date         DateTime        @db.Date
  startTime    String
  endTime      String
  breakMinutes Int             @default(0)
  status       TimeEntryStatus @default(SUBMITTED)
  note         String?
  managerComment String? // vraag/opmerking van de manager bij status QUERIED
  reviewedById String? // membershipId van de manager die goed-/afkeurde
  reviewedAt   DateTime?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  shift      Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, date])
}

// ---------- Kortingscodes ----------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountDuration {
  FOREVER
  LIMITED_MONTHS
}

enum DiscountInterval {
  MONTHLY
  YEARLY
  BOTH
}

// Een kortingscode die via het adminportaal wordt aangemaakt.
model DiscountCode {
  id                 String           @id @default(cuid())
  code               String           @unique
  type               DiscountType
  value              Int              // 1-100 bij PERCENTAGE, centen bij FIXED_AMOUNT (bv. 500 = €5,00)
  duration           DiscountDuration @default(FOREVER)
  durationMonths     Int?             // alleen relevant bij LIMITED_MONTHS
  applicableInterval DiscountInterval @default(BOTH) // alleen maandelijks, alleen jaarlijks, of allebei
  applicableTiers    String[]         @default([]) // staffel-id's ("S","M","L","XL") waarvoor de code geldt; leeg = alle staffels
  maxRedemptions     Int?             // null = onbeperkt
  timesRedeemed      Int              @default(0)
  active             Boolean          @default(true)
  expiresAt          DateTime?        // na deze datum niet meer in te wisselen
  createdAt          DateTime         @default(now())

  redemptions CompanyDiscount[]
}

// Vastlegging van welke zaak welke code heeft ingewisseld. Een zaak kan
// maar 1 actieve korting tegelijk hebben. De velden hieronder zijn een
// snapshot van de DiscountCode op het moment van inwisselen, zodat het
// later aanpassen van de oorspronkelijke code een al ingewisselde korting
// niet met terugwerkende kracht verandert.
model CompanyDiscount {
  id                 String           @id @default(cuid())
  companyId          String           @unique
  discountCodeId     String
  type               DiscountType
  value              Int
  duration           DiscountDuration
  durationMonths     Int?             // oorspronkelijke duur (voor weergave), blijft staan
  monthsRemaining    Int?             // telt af bij LIMITED_MONTHS, null bij FOREVER
  applicableInterval DiscountInterval @default(BOTH)
  applicableTiers    String[]         @default([]) // snapshot van de code; leeg = alle staffels
  redeemedAt         DateTime         @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id])
}

// Bijbetaling voor een jaarabonnement wanneer de zaak tijdens het jaar naar
// een hogere staffel groeit: verschil in jaarprijs x resterende maanden / 12,
// automatisch geïncasseerd via de bestaande Mollie-machtiging.
model TierUpgradeCharge {
  id              String   @id @default(cuid())
  companyId       String
  fromTierId      String
  toTierId        String
  periodKey       String   // volgende verlengdatum (YYYY-MM-DD): voorkomt dubbel incasseren in dezelfde periode
  monthsRemaining Int
  amountIncl      Float
  molliePaymentId String   @unique
  status          String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, toTierId, periodKey])
  @@index([companyId])
}
