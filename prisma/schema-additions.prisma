// ---------- 1. Nieuw model: Coupon ----------
// Ergens toevoegen, bv. na het Company-model.

enum CouponType {
  PERCENTAGE // value = percentage korting, bv. 20 = 20% korting
  FIXED // value = vast bedrag korting in euro's, excl. btw
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique // wordt bij gebruik uppercase vergeleken
  type           CouponType
  value          Float
  durationMonths Int? // aantal betaalperiodes dat de korting geldt; null = zo lang het abonnement loopt
  maxRedemptions Int? // null = onbeperkt aantal zaken dat 'm mag gebruiken
  timesRedeemed  Int        @default(0)
  expiresAt      DateTime? // na deze datum niet meer NIEUW toe te passen (al toegepaste blijven lopen)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  companies Company[]

  @@index([code])
}

